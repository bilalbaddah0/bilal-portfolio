@model BilalPortfolio.ViewModels.HomeViewModel
@{
    ViewData["Title"] = $"{Model.Portfolio.Name} | {Model.Portfolio.Title}";
    var skillGroups = new[]
    {
        new { Icon = "{ }", Title = "Backend", Skills = new[] { "C#", "ASP.NET", "ASP.NET Core", "REST APIs", "Entity Framework Core" } },
        new { Icon = "</>", Title = "Frontend", Skills = new[] { "HTML", "CSS", "JavaScript", "Bootstrap", "Telerik UI" } },
        new { Icon = "DB", Title = "Database", Skills = new[] { "SQL Server", "SQL", "Entity Framework", "Data Modeling" } },
        new { Icon = "→_", Title = "Development Tools", Skills = new[] { "Git", "GitHub", "Visual Studio", "Postman" } },
        new { Icon = "◇", Title = "Engineering", Skills = new[] { "OOP", "SOLID Principles", "Design Patterns", "Debugging", "Testing", "Database Integration" } }
    };

    var projects = new[]
    {
        new
        {
            Title = "Personal Developer Portfolio",
            Description = "A full-stack portfolio with a secure contact system, SQL Server storage, authentication, and a private message dashboard.",
            Image = "/images/portfolio-project.svg",
            Alt = "Preview of the personal developer portfolio dashboard",
            Technologies = new[] { "ASP.NET Core", "C#", "EF Core", "SQL Server", "Bootstrap" },
            GitHub = Model.Portfolio.GitHubUrl,
            Demo = "#home",
            Featured = true
        },
        new
        {
            Title = "Financial Message Processor",
            Description = "A web application that processes structured financial message files, persists extracted data, and presents it through a clear operational interface.",
            Image = "/images/message-processor.svg",
            Alt = "Placeholder preview of a financial message processing application",
            Technologies = new[] { "ASP.NET", "C#", "SQL", "Telerik UI" },
            GitHub = Model.Portfolio.GitHubUrl,
            Demo = "#",
            Featured = false
        },
        new
        {
            Title = "Next Project",
            Description = "Reserved for the next application in my portfolio. This card is ready to be updated with a description, links, screenshots, and technology tags.",
            Image = "/images/project-placeholder.svg",
            Alt = "Abstract placeholder for a future software project",
            Technologies = new[] { "ASP.NET Core", "REST API", "JavaScript" },
            GitHub = Model.Portfolio.GitHubUrl,
            Demo = "#",
            Featured = false
        }
    };
}

@if (TempData["CvMessage"] is string cvMessage)
{
    <div class="container pt-3">
        <div class="alert alert-info mb-0" role="status">@cvMessage</div>
    </div>
}

<section class="hero section-anchor" id="home" aria-labelledby="hero-title">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Open to opportunities</p>
            <h1 id="hero-title">@Model.Portfolio.Name</h1>
            <p class="hero-role"><span>@Model.Portfolio.Title</span></p>
            <p class="hero-intro">I build reliable web applications with C#, ASP.NET Core, SQL Server, and thoughtful user interfaces. My focus is maintainable software that solves practical business problems.</p>
            <div class="hero-actions">
                <a class="btn btn-primary-custom" href="#projects">View Projects</a>
                <a class="btn btn-secondary-custom" href="/cv" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14"></path></svg>
                    Download CV
                </a>
                <a class="text-link" href="#contact">Contact Me <span aria-hidden="true">→</span></a>
            </div>
            <div class="social-row" aria-label="Professional profiles">
                <a href="@Model.Portfolio.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4c.14-1.26-.37-2.5-1.4-3.25 3.4-.38 6.97-1.67 6.97-7.56A5.9 5.9 0 0 0 19 3.1 5.5 5.5 0 0 0 18.85 0S17.62-.4 15 1.56a14 14 0 0 0-6 0C6.38-.4 5.15 0 5.15 0A5.5 5.5 0 0 0 5 3.1a5.9 5.9 0 0 0-1.57 4.1c0 5.87 3.57 7.16 6.97 7.55A3.65 3.65 0 0 0 9 17.58V22"></path><path d="M9 19c-3 .92-3-1.5-4.2-2"></path></svg>
                    <span>GitHub</span>
                </a>
                <a href="@Model.Portfolio.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="9" width="4" height="12"></rect><circle cx="5" cy="5" r="2"></circle><path d="M11 21V9h4v2c.8-1.3 2-2.3 4-2.3 3 0 3 2.7 3 6.2V21h-4v-5.3c0-1.8-.3-3.2-1.8-3.2-1.7 0-2.2 1.3-2.2 3.2V21Z"></path></svg>
                    <span>LinkedIn</span>
                </a>
                <a href="mailto:@Model.Portfolio.Email" aria-label="Send Bilal an email">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>
                    <span>Email</span>
                </a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="code-window">
                <div class="window-bar"><span></span><span></span><span></span><small>PortfolioService.cs</small></div>
                <pre><code><span class="code-purple">public class</span> <span class="code-blue">Developer</span>
{
  <span class="code-purple">public string</span> Name <span class="code-purple">=&gt;</span>
    <span class="code-green">"Bilal Baddah"</span>;

  <span class="code-purple">public</span> Skill[] Stack <span class="code-purple">=&gt;</span>
  [
    <span class="code-green">"C#"</span>, <span class="code-green">"ASP.NET Core"</span>,
    <span class="code-green">"SQL Server"</span>, <span class="code-green">"JavaScript"</span>
  ];

  <span class="code-purple">public async</span> Task <span class="code-blue">BuildAsync</span>()
    <span class="code-purple">=&gt; await</span> CreateReliableSoftware();
}</code></pre>
            </div>
            <div class="tech-orbit tech-orbit-one">.NET</div>
            <div class="tech-orbit tech-orbit-two">C#</div>
            <div class="tech-orbit tech-orbit-three">SQL</div>
        </div>
    </div>
    <a class="scroll-cue" href="#about" aria-label="Scroll to about section"><span></span>Scroll to explore</a>
</section>

<section class="section section-anchor" id="about" aria-labelledby="about-title">
    <div class="container">
        <div class="section-heading">
            <p class="section-kicker">About me</p>
            <h2 id="about-title">Practical engineering, built with care.</h2>
        </div>
        <div class="about-grid">
            <div class="about-copy">
                <p class="lead">I’m a computer science student and full-stack developer focused on the Microsoft .NET ecosystem.</p>
                <p>I work with C#, ASP.NET, ASP.NET Core, SQL Server, HTML, CSS, JavaScript, REST APIs, and Git to build complete web applications from database to interface.</p>
                <p>My experience includes working on real applications, investigating and resolving issues, integrating databases, developing backend services, and maintaining clear web interfaces. I care about readable code, dependable behavior, and learning the reasoning behind each technical decision.</p>
            </div>
            <aside class="about-card" aria-label="Development priorities">
                <h3>How I work</h3>
                <ul>
                    <li><span>01</span><div><strong>Understand the problem</strong><small>Start with requirements and the people using the software.</small></div></li>
                    <li><span>02</span><div><strong>Build maintainably</strong><small>Use clear structure, focused responsibilities, and sensible patterns.</small></div></li>
                    <li><span>03</span><div><strong>Test the details</strong><small>Debug carefully across the interface, services, and data layer.</small></div></li>
                </ul>
            </aside>
        </div>
    </div>
</section>

<section class="section section-muted section-anchor" id="skills" aria-labelledby="skills-title">
    <div class="container">
        <div class="section-heading section-heading-row">
            <div>
                <p class="section-kicker">Technical skills</p>
                <h2 id="skills-title">Tools I use to build software.</h2>
            </div>
            <p>A practical toolkit covering application logic, interfaces, data, and delivery.</p>
        </div>
        <div class="skills-grid">
            @foreach (var group in skillGroups)
            {
                <article class="skill-card reveal">
                    <div class="skill-icon" aria-hidden="true">@group.Icon</div>
                    <h3>@group.Title</h3>
                    <div class="skill-list">
                        @foreach (var skill in group.Skills)
                        {
                            <span>@skill</span>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-anchor" id="experience" aria-labelledby="experience-title">
    <div class="container">
        <div class="section-heading">
            <p class="section-kicker">Work experience</p>
            <h2 id="experience-title">Experience with real applications.</h2>
        </div>
        <div class="timeline">
            <article class="timeline-item reveal">
                <div class="timeline-marker" aria-hidden="true"></div>
                <div class="timeline-meta">
                    <span>ABM</span>
                    <small>Professional experience</small>
                </div>
                <div class="timeline-content">
                    <h3>.NET Application Development</h3>
                    <p>Contributed to existing enterprise systems and production applications across development, support, and deployment.</p>
                    <ul>
                        <li>Developed and maintained .NET application features and backend functionality.</li>
                        <li>Investigated application issues through methodical debugging and testing.</li>
                        <li>Worked with databases, existing systems, and server deployment workflows.</li>
                        <li>Updated applications while protecting established business behavior.</li>
                    </ul>
                </div>
            </article>
            <article class="timeline-item reveal">
                <div class="timeline-marker" aria-hidden="true"></div>
                <div class="timeline-meta">
                    <span>AEG</span>
                    <small>Full-stack development</small>
                </div>
                <div class="timeline-content">
                    <h3>Financial Message Processing System</h3>
                    <p>Developed a full-stack application used to process structured financial message files and make the resulting information accessible through a web interface.</p>
                    <ul>
                        <li>Built workflows to read MT files, extract message data, and store it in SQL databases.</li>
                        <li>Developed ASP.NET backend services and integrated them with frontend components.</li>
                        <li>Built and maintained Telerik UI components for operational users.</li>
                        <li>Tested automatic file-processing workflows and debugged application behavior.</li>
                    </ul>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section section-dark section-anchor" id="projects" aria-labelledby="projects-title">
    <div class="container">
        <div class="section-heading section-heading-row">
            <div>
                <p class="section-kicker">Selected work</p>
                <h2 id="projects-title">Projects built around real problems.</h2>
            </div>
            <p>Each project combines maintainable backend design with a clear, responsive interface.</p>
        </div>
        <div class="projects-grid">
            @foreach (var project in projects)
            {
                <article class="project-card reveal">
                    <div class="project-image">
                        <img src="@project.Image" alt="@project.Alt" width="720" height="440" loading="lazy" />
                        @if (project.Featured)
                        {
                            <span class="featured-badge">Featured</span>
                        }
                    </div>
                    <div class="project-body">
                        <h3>@project.Title</h3>
                        <p>@project.Description</p>
                        <ul class="project-tech" aria-label="Technologies used">
                            @foreach (var technology in project.Technologies)
                            {
                                <li>@technology</li>
                            }
                        </ul>
                        <div class="project-links">
                            <a href="@project.GitHub" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                            <a href="@project.Demo">Live Demo <span aria-hidden="true">→</span></a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-anchor" id="education" aria-labelledby="education-title">
    <div class="container">
        <div class="section-heading">
            <p class="section-kicker">Education</p>
            <h2 id="education-title">A strong computer science foundation.</h2>
        </div>
        <article class="education-card reveal">
            <div class="education-monogram" aria-hidden="true">U</div>
            <div class="education-main">
                <p class="education-period">@Model.Portfolio.EducationYears</p>
                <h3>@Model.Portfolio.Degree</h3>
                <p class="education-school">@Model.Portfolio.University</p>
                <div class="coursework">
                    <span>Object-Oriented Programming</span>
                    <span>Data Structures</span>
                    <span>Database Systems</span>
                    <span>Software Engineering</span>
                    <span>Web Development</span>
                </div>
            </div>
        </article>
    </div>
</section>

<section class="section section-muted section-anchor" id="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
        <div class="contact-copy">
            <p class="section-kicker">Contact</p>
            <h2 id="contact-title">Let’s discuss your project or opportunity.</h2>
            <p>If you have a role, freelance project, or technical question in mind, send me a message. I’ll respond as soon as I can.</p>
            <div class="contact-direct">
                <span>Email</span>
                <a href="mailto:@Model.Portfolio.Email">@Model.Portfolio.Email</a>
            </div>
            <p class="contact-note"><span class="status-dot" aria-hidden="true"></span> Currently open to developer opportunities</p>
        </div>

        <div class="contact-panel">
            <form id="contact-form" action="/contact" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input class="honeypot" name="Website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div id="form-status" class="form-status" role="status" aria-live="polite" hidden></div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="full-name">Full name</label>
                        <input class="form-control" id="full-name" name="FullName" type="text" autocomplete="name" maxlength="100" required />
                        <span class="field-error">Please enter your full name.</span>
                    </div>
                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input class="form-control" id="email" name="Email" type="email" autocomplete="email" maxlength="254" required />
                        <span class="field-error">Please enter a valid email address.</span>
                    </div>
                </div>
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input class="form-control" id="subject" name="Subject" type="text" maxlength="150" required />
                    <span class="field-error">Please add a subject.</span>
                </div>
                <div class="form-group">
                    <div class="label-row"><label for="message">Message</label><span><span id="message-count">0</span>/3000</span></div>
                    <textarea class="form-control" id="message" name="Message" rows="6" maxlength="3000" required></textarea>
                    <span class="field-error">Please enter your message.</span>
                </div>
                <button class="btn btn-primary-custom submit-button" type="submit">
                    <span class="button-label">Send Message</span>
                    <span class="button-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span aria-hidden="true">→</span>
                </button>
            </form>
        </div>
    </div>
</section>
